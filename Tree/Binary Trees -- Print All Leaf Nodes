import java.util.*;
public class Main {
	static Scanner sc;
	static class Node{
		int data;
		Node left;
		Node right;
		Node(int data){
			this.data = data;
		}
	}
	public static Node createTree(){
		int n = sc.nextInt();
		if(n==-1) return null;
		Node root = new Node(n);
		Queue<Node> q = new LinkedList<>();
		q.add(root);
		while(!q.isEmpty()){
			Node temp = q.poll();
			int a = sc.nextInt();
			int b = sc.nextInt();
			if(a==-1) temp.left = null;
			else {
				temp.left = new Node(a);
				q.add(temp.left);
			}
			if(b==-1) temp.right = null;
			else{
				temp.right = new Node(b);
				q.add(temp.right);
			}
		}
		return root;
	}
	public static void solve(Node root){
		if(root==null) return;
		if(root.left==null && root.right==null) {
			System.out.print(root.data+" ");
			return;
		}
		solve(root.left);
		solve(root.right);
	}
    public static void main(String args[]) {
		sc = new Scanner(System.in);
		Node root = createTree();
		solve(root);
    }
}