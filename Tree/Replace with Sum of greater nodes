import java.util.*;
public class Main {
	static class Node{
		int data;
		Node left;
		Node right;
		Node(int d){
			data = d;
		}
	}
	static Scanner sc;
	public static  Node tree(int arr[], int i, int j){
		if(i==j) return new Node(arr[i]);
		if(i>j) return null;
		int mid = (i+j)/2;
		Node root = new Node(arr[mid]);
		root.left = tree(arr,i,mid-1);
		root.right = tree(arr,mid+1,j);
		return root;
	}
	public static Node createTree(){
		int n = sc.nextInt();
		int arr[] = new int[n];
		for(int i=0; i<n; i++) arr[i] = sc.nextInt();
		return tree(arr,0,n-1);
	}
	public static void print(Node root){
		if(root==null) return;
		System.out.print(root.data+" ");
		print(root.left);
		print(root.right);
	}
	static int sum = 0;
	public static void solve(Node root){
		if(root==null) return;
		solve(root.right);
		sum+=root.data;
		root.data = sum;
		solve(root.left);
	}
    public static void main(String args[]) {
		sc = new Scanner(System.in);
		Node root = createTree();
		solve(root);
		print(root);
    }
}