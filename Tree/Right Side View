import java.util.*;
import java.io.*;
public class Main {
    static class Node
    {
        int data;
        Node left,right;
        Node(int data)
        {
            this.data=data;
        }
    }
	static List<Integer> list = new ArrayList<>();
    public static void main(String args[]) throws Exception{
        Node root = construct();
        rightView(root,0);
		for(int i:list) System.out.print(i+" ");
    }
    public static Node construct(){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        if(n==-1) return null;
        Node root = new Node(n);
        Queue<Node> q = new LinkedList<>();
        q.add(root);
        while(!q.isEmpty()){
            Node temp = q.poll();
            int a = sc.nextInt();
            int b = sc.nextInt();
            if(a==-1) temp.left=null;
            else {
                temp.left = new Node(a);
                q.add(temp.left);
            }
            if(b==-1) temp.right=null;
            else{
                temp.right = new Node(b);
                q.add(temp.right);
            }
        }
        return root;
    }
    public static void rightView(Node root, int index){
        if(root==null) return;
        if(index==list.size()) list.add(root.data);
        rightView(root.right,index+1);
        rightView(root.left,index+1);
    }
}