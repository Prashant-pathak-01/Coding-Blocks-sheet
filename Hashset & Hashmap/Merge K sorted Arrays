import java.util.*;
public class Main {
    public static int [] merge(int arr[][], int n, int m){
        PriorityQueue<int []> pq = new PriorityQueue<>((a,b)->a[0]-b[0]);
        int res[] = new int[n*m];
        int x =0;
        for(int i=0; i<n; i++) pq.add(new int[]{arr[i][0],i,0});
        while(!pq.isEmpty()){
            int temp[] = pq.poll();
            if(temp[2]<m-1) pq.add(new int[]{arr[temp[1]][temp[2]+1],temp[1],temp[2]+1});
            res[x++] = temp[0];
        }
        return res;
    }
    public static void main(String args[]) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int m = sc.nextInt();
        int arr[][] = new int[n][m];
        for(int i=0; i<n; i++){
            for(int j=0; j<m; j++){
                arr[i][j] = sc.nextInt();
            }
        }
        int res[] = merge(arr,n,m);
        for(int i:res) System.out.print(i+" ");
    }
}