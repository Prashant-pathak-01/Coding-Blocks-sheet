import java.util.*;
public class Main {
    public static void main (String args[]) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int k = sc.nextInt();
        int arr[] = new int[n];
        for(int i=0; i<n; i++) arr[i]= sc.nextInt();
        PriorityQueue<Integer> pq = new PriorityQueue<>((a,b)->b-a);
        for(int i:arr) pq.add(i);
        while(k-->1) pq.poll();
        System.out.println(pq.poll());
    }
}